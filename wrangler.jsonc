{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "music-warehouse",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "observability": { "enabled": true },

  // ---------------------------------------------------------------------
  // FORKING THIS? Three values below are specific to one deployment and
  // must be replaced before `wrangler deploy` will work. See README,
  // "Setting it up from scratch". Neither id is a credential — both are
  // useless without a Cloudflare API token — but neither is yours.
  //   1. routes            — the custom domain, or delete for workers.dev
  //   2. database_id       — from `wrangler d1 create`
  //   3. SPOTIFY_REDIRECT_URI — must match the Spotify dashboard exactly
  // ---------------------------------------------------------------------

  // [1] Custom domain on the rcn.sh zone. Wrangler manages the DNS record.
  // Delete this block entirely to deploy to <name>.<subdomain>.workers.dev.
  "routes": [{ "pattern": "music-api.rcn.sh", "custom_domain": true }],

  // Poll cadence. 48 invocations/day, well inside either plan (the Free plan
  // allows 100,000 requests a day; this deployment is on Workers Paid).
  // Tighten to "*/15 * * * *" if gaps ever appear (see README, "Configuration").
  // Three cron triggers (Free allows five, Paid 250): ingestion every 30 minutes, a
  // daily sweep that pushes to ALERT_WEBHOOK_URL when something needs a human,
  // and the daily concert check (needs TICKETMASTER_API_KEY).
  "triggers": {
    "crons": ["*/30 * * * *", "0 9 * * *", "23 1 * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "music_warehouse",
      // [2] Replace with the id `wrangler d1 create music_warehouse` prints.
      "database_id": "cd50aaf2-62d6-47cf-a5bd-ae99a8d32556",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    // [3] Must exactly match a redirect URI registered in the Spotify
    // dashboard. `wrangler dev` overrides this from .dev.vars with the
    // loopback URL. Sign-in uses /auth/callback on the same host, which must
    // be registered too.
    "SPOTIFY_REDIRECT_URI": "https://music-api.rcn.sh/callback"

    // ALERT_MENTION is deliberately not here. It identifies a specific person
    // to a specific chat service, so it is set as a secret instead:
    //   npx wrangler secret put ALERT_MENTION
    // See README, "Alerting".
  }
}
