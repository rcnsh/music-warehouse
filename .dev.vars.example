# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars.
#
# In production these are set with `npx wrangler secret put <NAME>` rather than
# from this file. See README, "Setting it up from scratch".

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# openssl rand -hex 32
ADMIN_TOKEN=

# Deprecated: read-only credential for the /api/* routes. Prefer a read device
# token from POST /admin/tokens (README, "Device tokens"). Optional; every use
# logs a deprecation warning.
# openssl rand -hex 32
READ_TOKEN=

# Optional. Where the alert check after each poll POSTs when something needs a
# human — a Discord or Slack webhook URL, or https://ntfy.sh/<your-topic>.
# Unset means conditions are logged but never pushed. See README, "Alerting".
ALERT_WEBHOOK_URL=

# Optional. Leads every alert body so the receiver pings a human rather than
# just posting: a Discord `<@id>`, a Slack `<@U…>`, an ntfy tag.
ALERT_MENTION=

# Optional. A dead-man's switch fetched (GET) after every successful poll,
# e.g. https://hc-ping.com/<uuid> from healthchecks.io, which alerts when the
# pings stop: the one alert that still works when the Worker is down.
# Leave it unset locally, or wrangler dev pings it too. See README, "Heartbeat".
HEARTBEAT_URL=

# Optional. Comma-separated browser origins allowed to read /api/* with a
# token, e.g. a Wrapped app on another host, or http://localhost:5173 for its
# dev server. Unset means no CORS headers. See README, "Configuration".
CORS_ORIGINS=

# Optional. Comma-separated custom URL schemes a mobile app may sign in to,
# e.g. app.remastered. Loopback (http://127.0.0.1:<port>) needs no entry.
# See README, "Signing in with Spotify".
SIGN_IN_SCHEMES=

# Optional. The timezone listening stats read local time in, when ERAS is
# unset. An IANA name such as Europe/Berlin. Default UTC. Also the zone the
# play-count rollup is built in (the latest era's zone when only ERAS is set).
TIMEZONE=

# Optional. Stages of your life in different timezones, as a JSON list; each
# after the first needs `from`, and any can end with `to`. Time between
# stages is a gap on the stage before's clock. Replaces TIMEZONE. See README,
# step 2.
# ERAS=[{"key":"home","label":"Home","timeZone":"Europe/London","to":"2024-08-01T00:00:00Z"},{"key":"abroad","label":"Abroad","timeZone":"Asia/Tokyo","from":"2024-09-01T00:00:00Z"}]

# Optional. Where the stats' history starts, as an ISO instant; plays before
# it are ignored. Default: the first stored play.
# HISTORY_FROM=2020-07-01T00:00:00+01:00

# Optional. A Ticketmaster Discovery API consumer key and where to look for
# concerts, as a JSON list of up to five regions: a Ticketmaster countryCode,
# or a geoPoint geohash with a radius in km. Both turn on the daily concert
# check and GET /api/concerts; without either the route answers 404. See
# README, "Setting up concerts".
# TICKETMASTER_API_KEY=
# CONCERT_REGIONS=[{"key":"uk","label":"United Kingdom","countryCode":"GB"}]

# Optional. A Spicy Lyrics secret key (sl_sk_…) from
# https://developers.spicylyrics.org, which turns on GET /api/lyrics.
# Unset means the route answers 404. See README, "Lyrics".
SPICY_LYRICS_SECRET_KEY=

# Overrides the value in wrangler.local.jsonc (or the template) for local dev. Spotify
# permits plain HTTP only on the loopback address, and this must match a
# redirect URI registered in the Spotify dashboard character for character.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/callback
