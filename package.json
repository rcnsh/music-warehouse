{
  "name": "music-warehouse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/wrangler.mjs dev",
    "deploy": "node scripts/wrangler.mjs deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:clock": "bash scripts/clock-sweep.sh",
    "typecheck": "tsc --noEmit",
    "migrate:local": "node scripts/wrangler.mjs d1 migrations apply music_warehouse --local",
    "migrate:remote": "node scripts/wrangler.mjs d1 migrations apply music_warehouse --remote",
    "wrangler": "node scripts/wrangler.mjs",
    "import": "node scripts/import-export.mjs",
    "clean:export": "node scripts/clean-export.mjs",
    "backfill:albums": "node scripts/backfill-albums.mjs",
    "backfill:catalog": "node scripts/backfill-catalog.mjs",
    "authorize": "node scripts/authorize.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.9",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
